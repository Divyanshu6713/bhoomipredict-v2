node_modules
dist
.DS_Store
*.local

# Generated data artefacts. Rebuild with `npm run data` (~9 minutes).
data/*.csv
data/*.pdf
data/store/
data/model/*.f32
data/model/*.bin
# ...except the champion's per-row TreeSHAP contributors. Every other artefact here
# is cheap to rebuild, but this pass takes over two hours (see metrics.json
# `shap.seconds`), so no deployment build can produce it: it ships with the model.
# ml/train.py re-derives scores.f32 / delay_days.f32 from ensemble.json instead.
!data/model/shap_top.bin

# Raw boundary downloads (~100 MB). Rebuild the compact layers with `node scripts/build-geo.mjs`.
data/geo/source/

# Runtime state written by the API (workflow, audit, documents, sessions).
data/runtime/

# Continuous learning artefacts: recorded outcomes, archived model versions (rollback) and
# the withheld synthetic outcomes (rebuilt by `npm run data:generate`).
data/learning/
data/model/versions/
data/model/staging/
data/simulation/
